apiVersion: v1
kind: Pod
metadata: 
  name: delhipod
  labels:
    app: dev
spec:
  containers:
    - name: c01
      image: nginx:latest


      volumeMounts:
         - name: cache-volume
           mountPath: /data

    - name: c02
      image: redis:latest

      volumeMounts:
         - name: cache-volume
           mountPath: /data
  volumes:
   - name: cache-volume
     emptyDir: {}
